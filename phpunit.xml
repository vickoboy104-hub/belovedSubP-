<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- A developer's real .env must never let a test reach a live provider. -->
        <env name="GSUBZ_API_KEY" value=""/>
        <env name="ALT_PROVIDER_API_KEY" value=""/>
        <env name="ALT_PROVIDER_BASE_URL" value=""/>
        <env name="JHTECH_ENABLED" value="false"/>
        <env name="JHTECH_API_KEY" value=""/>
        <env name="NIN_API_KEY" value=""/>
        <env name="NIN_PRINT_ENDPOINT" value=""/>
        <env name="NIN_REPORTS_ENDPOINT" value=""/>
        <env name="NIN_VALIDATION_ENDPOINT" value=""/>
        <env name="BVN_API_KEY" value=""/>
        <env name="BVN_RETRIEVE_PHONE_ENDPOINT" value=""/>
        <env name="BVN_RETRIEVE_BMS_ENDPOINT" value=""/>
        <env name="BVN_PRINT_ENDPOINT" value=""/>
        <env name="FLUTTERWAVE_PUBLIC_KEY" value=""/>
        <env name="FLUTTERWAVE_SECRET_KEY" value=""/>
        <env name="FLUTTERWAVE_ENCRYPTION_KEY" value=""/>
        <env name="FLUTTERWAVE_SECRET_HASH" value=""/>
        <env name="SMS_API_KEY" value=""/>
        <env name="SMS_ENDPOINT" value=""/>
        <env name="SMS_SENDER_ID" value=""/>
        <!-- The same rule as the provider keys, applied to the two owner lists.
             A developer's .env names his own account so he can open the owner-only
             boards, and in a test database the factory's first user carries exactly
             that id. Left alone, the account under test silently inherits Master and
             every audit screen answers 200, so the tests that prove those doors are
             shut would pass for the wrong reason. -->
        <env name="AUDIT_OWNER_USER_IDS" value=""/>
        <env name="MASTER_ADMIN_USER_IDS" value=""/>
    </php>
</phpunit>
