<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="315"
                android:endColor="#4C1D95"
                android:startColor="#1E3A8A" />
        </shape>
    </item>

    <item
        android:height="22dp"
        android:left="16dp"
        android:top="18dp"
        android:width="22dp">
        <shape android:shape="oval">
            <solid android:color="#45FFFFFF" />
        </shape>
    </item>

    <item
        android:bottom="20dp"
        android:right="18dp"
        android:height="20dp"
        android:width="20dp">
        <shape android:shape="oval">
            <solid android:color="#36FFFFFF" />
        </shape>
    </item>

    <item
        android:drawable="@drawable/ic_onboarding_payments_symbol"
        android:gravity="center"
        android:height="120dp"
        android:width="120dp" />
</layer-list>
