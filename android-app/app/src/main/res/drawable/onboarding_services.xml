<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="315"
                android:endColor="#174A7C"
                android:startColor="#0B2545" />
        </shape>
    </item>

    <item
        android:height="20dp"
        android:left="18dp"
        android:top="18dp"
        android:width="20dp">
        <shape android:shape="oval">
            <solid android:color="#4DFFFFFF" />
        </shape>
    </item>

    <item
        android:bottom="18dp"
        android:right="20dp"
        android:height="26dp"
        android:width="26dp">
        <shape android:shape="oval">
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>

    <item
        android:drawable="@drawable/ic_onboarding_services_symbol"
        android:gravity="center"
        android:height="120dp"
        android:width="120dp" />
</layer-list>
